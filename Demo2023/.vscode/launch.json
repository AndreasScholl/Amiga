{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "amiga-assembly",
            "request": "launch",
            "name": "WinUAE A500",
            "noDebug": true,
            "program": "${workspaceFolder}/uae/dh0/d",
            "remoteProgram": "SYS:d",
            "emulatorType": "winuae",
            "emulatorArgs": [
                "-config=${workspaceFolder}/uae/a500.uae",
                "-s",
                "filesystem2=rw,DH0:dh0:${workspaceFolder}/uae/dh0,0"
            ],
            "preLaunchTask": "amigaassembly: build"
        },
        {
            "type": "amiga-assembly",
            "request": "launch",
            "name": "WinUAE A500 Debugger",
            "stopOnEntry": false,
            "program": "${workspaceFolder}/uae/d_debug",
            "remoteProgram": "SYS:d",
            "emulatorType": "winuae",
            "emulatorArgs": [
                "-config=${workspaceFolder}/uae/a500.uae",
                "-s",
                "filesystem2=rw,DH0:dh0:${workspaceFolder}/uae/dh0,0"
            ],
            "preLaunchTask": "F5 build"
        }
    ]
}
