{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "amigaassembly",
			"vasm": {
				"enabled": true,
				"command": "${config:amiga-assembly.binDir}/vasmm68k_mot",
				"args": [
					"-m68000",
					"-Fhunk",
					"-phxass"
				]
			},
			"vlink": {
				"enabled": true,
				"command": "${config:amiga-assembly.binDir}/vlink",
				"includes": "*.{s,S,asm,ASM}",
				"excludes": "",
				"exefilename": "../uae/dh0/d",
				"entrypoint": "main.s",
				"args": [
					"-bamigahunk",
					"-Bstatic",
					"-s"
				]
			},
			"problemMatcher": [],
			"label": "amigaassembly: build",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "amigaassembly",
			"vasm": {
				"enabled": true,
				"command": "${config:amiga-assembly.binDir}/vasmm68k_mot",
				"args": [
					"-m68000",
					"-Fhunk",
					"-phxass",
					"-linedebug"
				]
			},
			"vlink": {
				"enabled": true,
				"command": "${config:amiga-assembly.binDir}/vlink",
				"includes": "*.{s,S,asm,ASM}",
				"excludes": "",
				"exefilename": "../uae/d_debug",
				"entrypoint": "main.s",
				"args": [
					"-bamigahunk",
					"-Bstatic"
				]
			},
			"problemMatcher": [],
			"label": "amigaassembly: build debug",
			"group": "build"
		},
		{
			"type": "process",
			"label": "F5 strip",
			"command": "${env:USERPROFILE}/.vscode/extensions/prb28.amiga-assembly-1.8.13/resources/bin/win32/vlink.exe",
			"args": [
				"-bamigahunk",
				"-Bstatic",
				"-s",
				"-o",
				"../uae/dh0/d",
				"main.o",
				"scroller.o",
				"music.o",
				"asteroids.o"
			],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"problemMatcher": []
		},
		{
			"label": "F5 build",
			"dependsOrder": "sequence",
			"dependsOn": [
				"amigaassembly: build debug",
				"F5 strip"
			],
			"problemMatcher": []
		}
	]
}
